{
  "name": "aethercode-workspace",
  "version": "0.2.1",
  "private": true,
  "description": "AetherCode top-level workspace — wires the TypeScript modules (memory, compact, themes, tui, desktop) and points at the Java core (aethercode/) for build/test orchestration.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter \"./aethercode-memory\" --filter \"./aethercode-compact\" --filter \"./aethercode-themes\" --filter \"./aethercode-tui\" --filter \"./aethercode-desktop\" build",
    "build:java": "cd aethercode && mvn -B -ntp -DskipTests install",
    "build:all": "pnpm build:java && pnpm build",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "test:java": "cd aethercode && mvn -B -ntp test",
    "test:memory": "pnpm --filter aethercode-memory test",
    "test:compact": "pnpm --filter aethercode-compact test",
    "test:themes": "pnpm --filter aethercode-themes test",
    "test:tui": "pnpm --filter aethercode-tui test",
    "test:desktop": "pnpm --filter aethercode-desktop test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "bench": "node scripts/bench.mjs",
    "bench:tui": "node scripts/bench-tui.mjs",
    "bench:llm": "node scripts/bench-llm.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:bash": "bash scripts/smoke-test.sh",
    "smoke:ps1": "powershell -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "smoke:cmd": "scripts\\smoke-test.cmd"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.0"
  }
}
