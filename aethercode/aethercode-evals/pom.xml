<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.aethercode</groupId>
        <artifactId>aethercode-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aethercode-evals</artifactId>
    <name>AetherCode Evals</name>
    <description>
        Java 21 port of the `deepagents-evals` AI agent evaluation framework
        (libs/evals/ in the Python monorepo): continual-learning-bench adapter,
        eval CLI / radar / trial summary, harbor failure / stats / langgraph
        agent, and Harbor task adapters for Context-Bench and DRBench.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-core</artifactId>
        </dependency>
        <!--
            R-mod-2: orchestration primitives (verifier / selfcorrect /
            multiagent / runtime / perf) moved to aethercode-orchestration.
            The capability/* test classes keep using the legacy package
            (self-contained seam, see R-eval-MASTER-PLAN) so this dependency
            is currently only pulled in by DeepAgentsSystem + PaperPipeline E2E.
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-orchestration</artifactId>
        </dependency>
        <!--
            R-sdk-1: SDK interface conformance suite. The capability/*
            test classes verify the *capability* (planning, state, memory)
            with self-contained models. R-sdk-* verify that the actual
            AetherCode SDK class (Watchdog, CircuitBreaker, DagPlan, etc.)
            behaves correctly when consumed by the front-end / CLI / IDE
            plugin. The two layers are complementary: capability proves
            the design is sound; SDK proves the implementation matches.
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-sdk</artifactId>
        </dependency>
        <!--
            R-sdk-3: Memory interface conformance. Mirrors the SDK
            dependency above but for the persistence layer that the
            TUI memory panel and recall scorer consume.
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-memory</artifactId>
        </dependency>
        <!--
            R-sdk-4: cost / safety / permission interface. The
            aethercode-permission module exports CommandAllowlist
            (bash guard) and PermissionReasoner (3-verdict policy).
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-permission</artifactId>
        </dependency>
        <!--
            R-sdk-5: tool interface conformance. StandardTools
            exposes the 17 tools that the TUI tool palette and
            the agent call loop dispatch to; we verify the
            factory wires them up correctly and that each tool
            is identifiable by name (the classifier and the
            permission reasoner key off tool.name()).
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-tools</artifactId>
        </dependency>
        <!--
            R-sdk-6: JSON-RPC interface conformance. The TUI, the
            CLI, and the IDE plugin all talk to the engine over
            JSON-RPC 2.0; we verify the codec, error codes, and
            dispatcher behave to spec.
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-protocol</artifactId>
        </dependency>
        <!--
            R-sdk-7: A2A schema interface conformance. AetherCode
            participates in Google's Agent2Agent protocol — the
            AgentCard is published at /.well-known/agent-card.json
            and other agents (or our own front-end in a multi-agent
            mode) consume it to decide which skills to call.
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-a2a</artifactId>
        </dependency>
        <!--
            R-sdk-9..10: WorkflowEngine + Hooks interface conformance.
            Both modules drive the TUI's "workflow run" and "hook
            system" surfaces; the engine contract is what the user
            sees as "click a workflow, see progress".
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-workflows</artifactId>
        </dependency>
        <!--
            R-sdk-10: Hooks interface conformance. The hook
            registry + PhaseTracker + WriteExistingFileGuardHook
            are the engine's safety net; if any of them breaks,
            every tool call goes through un-vetted.
        -->
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-hooks</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                R-radar-2: the evals module is self-contained (no other
                module depends on it), so compile + test in the normal
                `mvn test` cycle. Tests are pure-Java and don't shell
                out to uv / pytest; the ShellRunner seam in Cli keeps
                that side effect under test control.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- DrbenchAdapter / ContextbenchAdapter tests require
                             python-side fixtures; left out of the unit cycle. -->
                        <exclude>**/Drbench*Test.java</exclude>
                        <exclude>**/Contextbench*Test.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
