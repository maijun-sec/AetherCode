<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.org/POM/4.0.0 http://maven.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.aethercode</groupId>
        <artifactId>aethercode-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>aethercode-a2a-deepagent-bridge</artifactId>
    <name>AetherCode A2A ↔ DeepAgent Bridge</name>
    <description>
        R250+2: bridge that wires a {@code DeepAgent} (from
        aethercode-deepagents) into an {@code A2AServer} (from
        aethercode-a2a). Exposes both the synchronous and
        streaming handler shapes so the same deepagent can serve
        {@code message/send} and {@code message/sendSubscribe}
        over the same wire surface.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-a2a</artifactId>
        </dependency>
        <dependency>
            <groupId>org.aethercode</groupId><artifactId>aethercode-deepagents</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
