{
  "name": "aethercode-tui",
  "version": "0.2.1",
  "description": "Modern terminal UI for AetherCode. Communicates with the AetherCode daemon over JSON-RPC 2.0. Built on Ink (React for CLI).",
  "type": "module",
  "bin": {
    "ac-tui": "dist/ac-tui.js"
  },
  "main": "dist/ac-tui.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "build:npm": "tsc -p tsconfig.json && node scripts/bundle.mjs --target=npm",
    "build:standalone": "bun build --compile --target=bun-windows-x64 --outfile dist/ac-tui-standalone.exe src/tui.tsx",
    "build:standalone:linux": "bun build --compile --target=bun-linux-x64 --outfile dist/ac-tui-standalone src/tui.tsx",
    "build:standalone:macos": "bun build --compile --target=bun-darwin-arm64 --outfile dist/ac-tui-standalone src/tui.tsx",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/ac-tui.js",
    "test": "node --test scripts/test/*.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "agent",
    "tui",
    "aethercode",
    "claude-code",
    "ink"
  ],
  "license": "MIT",
  "dependencies": {
    "aethercode-memory": "file:../aethercode-memory",
    "aethercode-themes": "file:../aethercode-themes",
    "chalk": "^5.3.0",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-link": "^4.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "optionalDependencies": {
    "koffi": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.6.0"
  }
}
