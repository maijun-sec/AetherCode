# ============================================================
# AetherCode .gitignore
# ============================================================
# 
# 排除 build output、临时文件、IDE 配置、release 资产等
# 不应该提交到 git 仓的内容。
#
# 远端仓: https://github.com/maijun-sec/AetherCode
# 参考仓库 (claude-code-analysis, oh-my-opencode) 通过 .gitmodules 拉取,
# 本地 clone 副本请勿提交。
# ============================================================

# ------------------------------------------------------------
# Build / target output
# ------------------------------------------------------------
target/
build/
dist/
out/
bin/
*.class
*.jar
*.war
*.ear
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.pyc
*.pyo
*.pdb

# Node / TypeScript
node_modules/
.npm/
.yarn/
.pnpm-store/
*.tsbuildinfo
.next/
.nuxt/
.turbo/
.parcel-cache/

# Rust / Cargo (aethercode-desktop/src-tauri)
target/
**/target/
Cargo.lock.bak
**/*.rs.bk
*.pdb
*.so
*.dylib

# Java / Maven
target/
.mvn/
mvnw
mvnw.cmd
*.class
hs_err_pid*

# Gradle (aethercode-acp 可能有)
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# TypeScript
*.tsbuildinfo
.eslintcache
.parcel-cache/

# Bun (oh-my-opencode 等)
bun.lockb

